# Database URL (SQLite default for zero-setup prototype, or postgresql://user:pass@localhost:5432/sentinel_m3)
DATABASE_URL=sqlite:///./sentinel_m3.db

# Kaaval HMAC Secret (matches sentinel_hwsim push --secret argument)
KAAVAL_HMAC_SECRET=dev-secret
KAAVAL_HMAC_MAX_SKEW_S=300

# Event Deduplication Window (in seconds)
DEDUP_WINDOW_S=3600

# Logging
LOG_LEVEL=INFO

# Downstream Module 4 Delivery Mode ("log" or "http")
M4_DELIVERY_MODE=log
M4_ENDPOINT_URL=http://localhost:9000/events

# ==============================================================================
# Sentinel Camera Grid: live CCTV feeds
# ==============================================================================
# Your grid account. Use the email exactly as you registered it (the "@" is
# percent-encoded for you when the RTSP address is built).
SENTINEL_GRID_EMAIL=
SENTINEL_GRID_PASSWORD=

# Grid endpoints. Change only if the grid moves.
SENTINEL_GRID_HOST=103.250.160.189
SENTINEL_GRID_RTSP_PORT=8554
SENTINEL_GRID_WEB_BASE=https://cctv.corp8.cloud

SENTINEL_GRID_WHEP_PORT=8889
# How often M3 re-reads the grid catalogue (seconds). 0 = only on POST /api/v1/grid/sync.
GRID_SYNC_INTERVAL_S=900

# ==============================================================================
# Stream relay (our MediaMTX). Browsers and Module 2 only ever talk to this,
# never to the grid. The generated config holds the grid login: it is git-ignored.
# ==============================================================================
RELAY_ENABLED=true
RELAY_BIN=relay/bin/mediamtx.exe
RELAY_CONFIG_PATH=relay/generated/mediamtx.yml
RELAY_API_URL=http://127.0.0.1:9997
# The host name a BROWSER uses to reach the relay.
RELAY_PUBLIC_HOST=localhost
RELAY_RTSP_PORT=8654
RELAY_HLS_PORT=8888
RELAY_WEBRTC_PORT=8889
# Web pages allowed to play from the relay (comma separated origins).
RELAY_ALLOW_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Leave empty to find ffmpeg on PATH (used to turn H.265 cameras into H.264 for browsers).
FFMPEG_PATH=

# ==============================================================================
# Live detection worker: python -m app.live.worker
# ==============================================================================
# Grid cameras to watch, comma separated. The grid gives every connection its
# own stream copy, so keep this small. Leave empty to take the first
# LIVE_MAX_CAMERAS cameras from the grid's catalogue.
LIVE_CAMERAS=cam01,cam02,cam03
LIVE_MAX_CAMERAS=3

# Detections per second of video (measured on the stream's own timestamps).
LIVE_SAMPLE_FPS=4
# Ignore detections below this confidence (0 to 1).
LIVE_MIN_CONFIDENCE=0.45

# The worker registers itself in M3 as this AI processing node.
LIVE_NODE_ID=LIVE-DETECTOR-001
# Where the worker sends detected events (your M3 API). It signs each batch with
# KAAVAL_HMAC_SECRET above, so the two must match.
M3_INGEST_BASE_URL=http://localhost:8000

# Folder for the downloaded detector model files (git-ignored).
LIVE_MODEL_DIR=models
